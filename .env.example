# 复制为 .env 后按需修改。.env 不会进入版本库。
#
# 所有配置项及默认值见 config/default.toml。
# 任何配置项都可以用 APP_<SECTION>_<KEY> 环境变量覆盖。

# 运行环境：决定加载 config/development.toml 还是 config/production.toml
APP_ENV=development

# ---- 必需 ----

# 数据库连接 URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/{{project-name | snake_case}}_db

# JWT 签名密钥（至少 32 个字符）。生成方式：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# ---- 可选 ----

# Redis 连接 URL（不配置则不启用 Redis）
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:password@localhost:6379/0

# 常用覆盖项示例
# APP_SERVER_HOST=127.0.0.1
# APP_SERVER_PORT=3001
# APP_SERVER_ENABLE_DOCS=true
# APP_DATABASE_MAX_CONNECTIONS=20
# APP_DATABASE_AUTO_CREATE=true      # 目标数据库不存在时自动创建（开发环境默认开启）
# APP_DATABASE_SEED_DEMO=true        # 创建演示用户 demo / demo-password
# APP_AUTH_TOKEN_TTL_SECS=86400
# APP_LOGGING_LEVEL=debug
# APP_LOGGING_FILE=false
# APP_CORS_ALLOW_ORIGINS=https://a.example.com,https://b.example.com

# docker compose 使用的 PostgreSQL 账号与库名（compose 会据此覆盖容器内的 DATABASE_URL）
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DB=my_axum_starter_db

# 按模块过滤日志（设置后会取代 logging.level）
# RUST_LOG=info,tower_http=debug,sea_orm=debug
